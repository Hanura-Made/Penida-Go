---
import { TRUST_BADGES, SITE_INFO } from '@/data/landingData';
---

<section id="home" class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden text-white min-h-[640px] flex items-center">
  <!-- LCP Hero Image — eager + fetchpriority + srcset for responsive -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&fm=webp&w=1200&q=85"
      srcset="
        https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&fm=webp&w=640&q=80  640w,
        https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&fm=webp&w=1200&q=85 1200w,
        https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&fm=webp&w=2000&q=85 2000w
      "
      sizes="100vw"
      alt="Scenic ocean cliffs and turquoise water of Nusa Penida Bali — private transfer Bali"
      width="1200"
      height="720"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover object-center brightness-[0.78]"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/90 via-ocean-950/40 to-ocean-950/70"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Hero Copy -->
    <div class="max-w-2xl text-left space-y-4 mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ocean-500/25 border border-ocean-400/30 text-ocean-200 text-xs sm:text-sm font-semibold tracking-wide uppercase backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-ocean-400 animate-pulse" aria-hidden="true"></span>
        Bali & Nusa Penida Transfer
      </div>

      <!-- H1 with target keywords -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
        Private Transfer Bali &<br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-200 to-white">
          Nusa Penida, Made Simple.
        </span>
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-slate-200 font-normal leading-relaxed max-w-xl">
        Reliable private car & fast boat transfer for your trip around Bali & Nusa Penida. Safe, comfortable, and on time.
      </p>
    </div>

    <!-- Booking Form -->
    <div class="bg-white/95 backdrop-blur-md rounded-2xl p-4 sm:p-6 shadow-2xl border border-white/20 text-slate-900 max-w-5xl">
      <form
        id="hero-booking-form"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 items-end"
        aria-label="Search and book a transfer route"
      >
        <!-- From -->
        <div class="space-y-1.5">
          <label for="pickup-location" class="block text-xs font-bold uppercase tracking-wider text-slate-500">From</label>
          <div class="relative">
            <select id="pickup-location" name="pickup" required class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2.5 text-sm text-slate-800 font-medium focus:ring-2 focus:ring-ocean-500 focus:outline-none appearance-none">
              <option value="Sanur Port">Sanur Port</option>
              <option value="Ngurah Rai Airport (DPS)">Ngurah Rai Airport (DPS)</option>
              <option value="Ubud">Ubud</option>
              <option value="Kuta / Seminyak / Canggu">Kuta / Seminyak / Canggu</option>
              <option value="Nusa Penida (Toya Pakeh)">Nusa Penida (Toya Pakeh)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-400" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>
        </div>

        <!-- To -->
        <div class="space-y-1.5">
          <label for="dropoff-location" class="block text-xs font-bold uppercase tracking-wider text-slate-500">To</label>
          <div class="relative">
            <select id="dropoff-location" name="dropoff" required class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2.5 text-sm text-slate-800 font-medium focus:ring-2 focus:ring-ocean-500 focus:outline-none appearance-none">
              <option value="Nusa Penida">Nusa Penida Harbor</option>
              <option value="Sanur Port (Bali)">Sanur Port (Bali)</option>
              <option value="Nusa Penida Island Tour">Nusa Penida Island Tour (Full Day)</option>
              <option value="Ngurah Rai Airport (DPS)">Ngurah Rai Airport (DPS)</option>
              <option value="Ubud Hotel">Ubud Hotel</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-400" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>
        </div>

        <!-- Date -->
        <div class="space-y-1.5">
          <label for="travel-date" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Date</label>
          <input
            type="date"
            id="travel-date"
            name="travel_date"
            required
            class="w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-sm text-slate-800 font-medium focus:ring-2 focus:ring-ocean-500 focus:outline-none"
          />
        </div>

        <!-- Passengers -->
        <div class="space-y-1.5">
          <label for="passengers-count" class="block text-xs font-bold uppercase tracking-wider text-slate-500">Passengers</label>
          <div class="relative">
            <select id="passengers-count" name="passengers" class="w-full bg-slate-50 border border-slate-200 rounded-lg pl-3 pr-8 py-2.5 text-sm text-slate-800 font-medium focus:ring-2 focus:ring-ocean-500 focus:outline-none appearance-none">
              <option value="1-2 Passengers">1 - 2 Passengers</option>
              <option value="3-4 Passengers">3 - 4 Passengers</option>
              <option value="5-7 Passengers (Van)">5 - 7 Passengers (Van)</option>
              <option value="8+ Passengers (Group)">8+ Passengers (Group)</option>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-slate-400" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </div>
          </div>
        </div>

        <!-- Submit -->
        <div>
          <!-- Inline error message -->
          <p id="form-error" class="text-xs text-red-500 mb-1.5 hidden" role="alert"></p>
          <button
            type="submit"
            class="w-full bg-ocean-600 hover:bg-ocean-700 text-white font-semibold py-2.5 px-4 rounded-lg shadow-md transition-all duration-150 flex items-center justify-center gap-2 hover:shadow-lg active:scale-[0.98]"
          >
            <span>Find Your Ride</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </button>
        </div>
      </form>
    </div>

    <!-- Trust Badges -->
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl">
      {
        TRUST_BADGES.map((badge) => (
          <div class="flex items-center gap-3 bg-ocean-950/60 backdrop-blur-md px-3 py-2.5 rounded-xl border border-white/10">
            <div class="w-8 h-8 rounded-lg bg-ocean-600/30 flex items-center justify-center text-ocean-400 flex-shrink-0" aria-hidden="true">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <p class="text-xs sm:text-sm font-semibold text-white leading-tight">{badge.title}</p>
              <p class="text-xs text-slate-300 leading-tight">{badge.subtitle}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline define:vars={{ waUrl: SITE_INFO.whatsappUrl }}>
  (function () {
    const form     = document.getElementById('hero-booking-form');
    const errEl    = document.getElementById('form-error');
    const dateInput = document.getElementById('travel-date');

    // Set default date to tomorrow
    if (dateInput) {
      const today    = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(today.getDate() + 1);
      dateInput.min   = today.toISOString().split('T')[0];
      dateInput.value = tomorrow.toISOString().split('T')[0];
    }

    if (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const pickup  = form.pickup.value;
        const dropoff = form.dropoff.value;
        const date    = form.travel_date.value;
        const pax     = form.passengers.value;

        // Validate: From ≠ To
        if (pickup === dropoff) {
          errEl.textContent = 'Pickup and drop-off cannot be the same location.';
          errEl.classList.remove('hidden');
          form.dropoff.focus();
          return;
        }
        errEl.classList.add('hidden');

        const message = `Halo Penida-Go, saya ingin reservasi private transfer:\n- Dari: ${pickup}\n- Menuju: ${dropoff}\n- Tanggal: ${date}\n- Jumlah: ${pax}\n\nMohon info ketersediaan dan total biayanya. Terima kasih!`;
        window.open(`https://wa.me/62895623170470?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      });

      // Clear error when user changes selects
      ['pickup', 'dropoff'].forEach(name => {
        form[name].addEventListener('change', () => errEl.classList.add('hidden'));
      });
    }
  })();
</script>
