---
import Accordion from '@/components/ui/Accordion.astro';
import { FAQ_LIST, SITE_INFO } from '@/data/landingData';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': FAQ_LIST.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': { '@type': 'Answer', 'text': item.answer }
  }))
};
---

<section id="faq" class="py-16 md:py-24 bg-slate-50 border-t border-slate-100">
  <!-- FAQPage Rich Snippet (also passed to MainLayout head via schema prop) -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-ocean-50 text-ocean-700 text-xs font-semibold tracking-wide uppercase">
        Help & Clarity
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Frequently Asked Questions
      </h2>
      <p class="text-sm sm:text-base text-slate-600">
        Temukan jawaban seputar layanan private transfer Bali, tiket fast boat Sanur, dan transportasi Nusa Penida.
      </p>
    </div>

    <div id="faq-list" class="space-y-3.5">
      {
        FAQ_LIST.map((faq, index) => (
          <Accordion title={faq.question} defaultOpen={index === 0}>
            {faq.answer}
          </Accordion>
        ))
      }
    </div>

    <div class="mt-10 text-center bg-white rounded-xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left">
        <h3 class="text-sm font-semibold text-slate-900">Masih punya pertanyaan lain seputar perjalanan Anda?</h3>
        <p class="text-xs text-slate-500 mt-0.5">Tim customer service kami siap membantu Anda 24 jam via WhatsApp.</p>
      </div>
      <a
        href={SITE_INFO.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2.5 rounded-lg shadow-sm transition-all whitespace-nowrap"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Chat CS WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<!-- Accordion mutual-exclusion (zero library, ~200 bytes) -->
<script is:inline>
  document.getElementById('faq-list')?.querySelectorAll('details').forEach(function(el) {
    el.addEventListener('toggle', function() {
      if (el.open) {
        document.getElementById('faq-list').querySelectorAll('details').forEach(function(other) {
          if (other !== el) other.open = false;
        });
      }
    });
  });
</script>

