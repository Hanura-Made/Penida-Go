---
import Card from '@/components/ui/Card.astro';
import { TESTIMONIALS } from '@/data/landingData';
---

<section id="testimonials" class="py-16 md:py-24 bg-slate-50 border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        What Travelers Say
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Real stories and verified experiences from travelers exploring Bali & Nusa Penida.
      </p>
    </div>

    <!-- Testimonial Cards (Scroll snap on mobile, 3-column grid on desktop) -->
    <div class="flex md:grid md:grid-cols-3 gap-6 overflow-x-auto md:overflow-visible pb-4 md:pb-0 snap-x snap-mandatory scroll-smooth -mx-4 px-4 md:mx-0 md:px-0 scrollbar-none">
      {
        TESTIMONIALS.map((item) => (
          <article class="min-w-[290px] md:min-w-0 flex-shrink-0 snap-start">
            <Card class="p-6 h-full flex flex-col justify-between">
              <div>
                <!-- Star Rating -->
                <div class="flex items-center gap-1 text-amber-400 mb-4" aria-label={`${item.rating} out of 5 stars`}>
                  {Array.from({ length: item.rating }).map(() => (
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- Review Content -->
                <blockquote class="text-sm text-slate-700 leading-relaxed italic">
                  "{item.review}"
                </blockquote>
              </div>

              <!-- Author Info -->
              <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-ocean-100 text-ocean-700 flex items-center justify-center font-bold text-xs">
                  {item.name.charAt(0)}
                </div>
                <div>
                  <h4 class="text-xs font-bold text-slate-900 leading-tight">{item.name}</h4>
                  <p class="text-[11px] text-slate-400 leading-tight">{item.origin} • {item.date}</p>
                </div>
              </div>
            </Card>
          </article>
        ))
      }
    </div>
  </div>
</section>
