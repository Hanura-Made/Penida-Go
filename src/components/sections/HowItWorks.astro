---
import { HOW_IT_WORKS } from '@/data/landingData';
---

<section id="how-it-works" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        How It Works
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Book your ride in 3 simple steps with zero complicated registration.
      </p>
    </div>

    <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        HOW_IT_WORKS.map((step, idx) => (
          <div class="relative flex flex-col items-center text-center p-6 rounded-2xl bg-slate-50 border border-slate-100 hover:border-slate-200 transition-colors">
            <!-- Step Badge Number -->
            <div class="flex items-center justify-center w-12 h-12 rounded-full bg-ocean-600 text-white font-extrabold text-sm mb-4 shadow-sm">
              {step.number}
            </div>

            <!-- Icon -->
            <div class="w-10 h-10 rounded-lg bg-white border border-slate-200 text-ocean-600 flex items-center justify-center mb-3">
              {step.icon === 'map' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
              )}
              {step.icon === 'message-circle' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              )}
              {step.icon === 'user-check' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
              )}
            </div>

            <h3 class="text-base font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
