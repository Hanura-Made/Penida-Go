---
import Card from '@/components/ui/Card.astro';
import { SERVICES } from '@/data/landingData';
---

<section id="services" class="py-16 md:py-24 bg-slate-50 border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        Our Services
      </h2>
      <p class="text-sm sm:text-base text-slate-600 mt-2">
        Various transportation services tailored for your seamless Bali & Nusa Penida exploration.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {
        SERVICES.map((service) => (
          <Card hoverEffect class="p-6 flex flex-col justify-between text-left">
            <div>
              <div class="w-12 h-12 rounded-xl bg-ocean-50 text-ocean-600 flex items-center justify-center mb-4">
                {service.icon === 'car' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 17h.01M16 17h.01M3 11l2-6h14l2 6M5 11h14M5 11v6a1 1 0 001 1h1a1 1 0 001-1v-1h8v1a1 1 0 001 1h1a1 1 0 001-1v-6" /></svg>
                )}
                {service.icon === 'ship' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17l1.5-6h15l1.5 6M4 21a4 4 0 008 0 4 4 0 008 0M12 3v8m0 0l-3-3m3 3l3-3" /></svg>
                )}
                {service.icon === 'compass' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-linecap="round" stroke-linejoin="round"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                )}
                {service.icon === 'plane' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                )}
                {service.icon === 'map-pin' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                )}
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">{service.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed">{service.description}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100">
              <a
                href={`https://wa.me/62895623170470?text=${encodeURIComponent(
                  `Halo Penida-Go, saya ingin menanyakan layanan: ${service.title}`
                )}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-semibold text-ocean-600 hover:text-ocean-700 flex items-center gap-1"
              >
                Inquire now <span>→</span>
              </a>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
