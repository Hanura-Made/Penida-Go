---
import Card from '@/components/ui/Card.astro';
import { POPULAR_ROUTES, SITE_INFO } from '@/data/landingData';
---

<section id="routes" class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          Popular Routes
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Discover the most traveled routes and plan your trip with reliable private transfers.
        </p>
      </div>
      <a
        href={SITE_INFO.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-ocean-600 hover:text-ocean-700 group whitespace-nowrap"
      >
        <span>Custom route request</span>
        <span class="group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

    <!-- Route Cards Grid (Scroll Snap on Mobile, Grid on Desktop) -->
    <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-6 overflow-x-auto sm:overflow-visible pb-4 sm:pb-0 snap-x snap-mandatory scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0 scrollbar-none">
      {
        POPULAR_ROUTES.map((route) => (
          <article class="min-w-[280px] sm:min-w-0 flex-shrink-0 snap-start">
            <Card hoverEffect class="h-full flex flex-col group">
              <!-- Route Image -->
              <div class="relative h-44 overflow-hidden bg-slate-100">
                <img
                  src={route.image}
                  alt={route.alt}
                  width="400"
                  height="260"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="absolute top-3 left-3 bg-ocean-950/70 backdrop-blur-sm text-white text-[11px] font-medium px-2.5 py-1 rounded-md">
                  {route.duration}
                </span>
              </div>

              <!-- Card Body -->
              <div class="p-5 flex flex-col flex-grow justify-between">
                <div>
                  <h3 class="text-base font-bold text-slate-900 group-hover:text-ocean-600 transition-colors">
                    {route.from} <span class="text-ocean-500">→</span> {route.to}
                  </h3>
                  <p class="text-xs text-slate-500 mt-1">
                    Private car & fast boat transfer
                  </p>
                </div>

                <div class="mt-5 pt-3 border-t border-slate-100 flex items-center justify-between">
                  <div>
                    <span class="text-[11px] uppercase tracking-wider text-slate-400 font-medium block">Starting from</span>
                    <span class="text-base font-bold text-slate-900">{route.price}</span>
                  </div>

                  <a
                    href={`https://wa.me/62895623170470?text=${encodeURIComponent(
                      `Halo Penida-Go, saya tertarik memesan rute ${route.from} ke ${route.to} (${route.price}). Mohon info jadwal keberangkatan.`
                    )}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-9 h-9 rounded-full bg-ocean-50 group-hover:bg-ocean-600 text-ocean-600 group-hover:text-white flex items-center justify-center transition-colors"
                    aria-label={`Book route ${route.from} to ${route.to}`}
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </Card>
          </article>
        ))
      }
    </div>
  </div>
</section>
