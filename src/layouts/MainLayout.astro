---
import { Image } from 'astro:assets';
import logoImage from '@/assets/logo.png';
import { SITE_INFO } from '@/data/landingData';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'Penida-Go — Private Transfer Bali & Nusa Penida',
  description = 'Reliable private car transfer & fast boat tickets around Bali and Nusa Penida. Local drivers, fixed price, instant WhatsApp booking.',
  ogImage = 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?auto=format&fit=crop&w=1200&q=80',
  canonical = 'https://penidago.com',
  schema
} = Astro.props;

const companySchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': 'https://penidago.com/#organization',
  name: 'Penida-Go',
  url: 'https://penidago.com',
  logo: 'https://penidago.com/logo.webp',
  image: ogImage,
  description: description,
  telephone: SITE_INFO.phone,
  priceRange: 'Rp 150.000 - Rp 600.000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Sanur Port Harbor & Toya Pakeh',
    addressLocality: 'Denpasar',
    addressRegion: 'Bali',
    postalCode: '80227',
    addressCountry: 'ID'
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Bali' },
    { '@type': 'AdministrativeArea', name: 'Nusa Penida' }
  ],
  currenciesAccepted: 'IDR'
};

const combinedSchema = schema
  ? Array.isArray(schema)
    ? [companySchema, ...schema]
    : [companySchema, schema]
  : companySchema;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Technical SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="alternate" hreflang="en" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Penida-Go" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect hints for CDN assets -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(combinedSchema)} />

    <style>
      /* scrollbar-none utility */
      .scrollbar-none { scrollbar-width: none; }
      .scrollbar-none::-webkit-scrollbar { display: none; }
    </style>
  </head>
  <body class="bg-white text-slate-800 antialiased font-sans flex flex-col min-h-screen">

    <!-- ── HEADER ─────────────────────────────── -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between gap-4">

        <!-- Logo -->
        <a href="/" class="flex-shrink-0" aria-label="Penida-Go Homepage">
          <Image
            src={logoImage}
            alt="Penida-Go"
            width={168}
            height={44}
            class="h-8 sm:h-9 md:h-10 w-auto object-contain"
            loading="eager"
            format="webp"
          />
        </a>

        <!-- Desktop Nav -->
        <nav
          class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-medium text-slate-600"
          aria-label="Main navigation"
        >
          <a href="#home" class="hover:text-ocean-600 transition-colors">Home</a>
          <a href="#routes" class="hover:text-ocean-600 transition-colors">Routes</a>
          <a href="#services" class="hover:text-ocean-600 transition-colors">Services</a>
          <a href="#how-it-works" class="hover:text-ocean-600 transition-colors">How It Works</a>
          <a href="#pricing" class="hover:text-ocean-600 transition-colors">Pricing</a>
          <a href="#faq" class="hover:text-ocean-600 transition-colors">FAQ</a>
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
          <a
            href={SITE_INFO.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-ocean-600 hover:bg-ocean-700 text-white text-xs sm:text-sm font-semibold px-3 sm:px-4 py-2 sm:py-2.5 rounded-lg shadow-sm transition-all duration-150 hover:shadow active:scale-[0.98]"
          >
            <svg class="w-4 h-4 fill-current flex-shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span class="hidden sm:inline">Book via WhatsApp</span>
            <span class="sm:hidden">Book</span>
          </a>

          <!-- Hamburger (mobile only) -->
          <button
            id="mobile-menu-btn"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open navigation menu"
            class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg border border-slate-200 text-slate-600 hover:text-ocean-600 hover:border-ocean-300 transition-colors"
          >
            <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile dropdown menu -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-slate-100 bg-white shadow-lg">
        <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1" aria-label="Mobile navigation">
          <a href="#home"         class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">Home</a>
          <a href="#routes"       class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">Routes</a>
          <a href="#services"     class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">Services</a>
          <a href="#how-it-works" class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">How It Works</a>
          <a href="#pricing"      class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">Pricing</a>
          <a href="#faq"          class="mobile-nav-link px-3 py-2.5 rounded-lg text-sm font-medium text-slate-700 hover:bg-ocean-50 hover:text-ocean-700 transition-colors">FAQ</a>
          <div class="mt-2 pt-3 border-t border-slate-100">
            <a
              href={SITE_INFO.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-3 rounded-lg transition-colors"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              Book via WhatsApp
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- ── MAIN ──────────────────────────────── -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- ── FOOTER ────────────────────────────── -->
    <footer class="bg-ocean-950 text-slate-300 pt-16 pb-12 border-t border-slate-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800/80">

          <!-- Brand -->
          <div class="md:col-span-2 space-y-4">
            <a href="/" class="inline-block bg-white px-3.5 py-2 rounded-xl shadow-sm hover:opacity-95 transition-opacity" aria-label="Penida-Go">
              <Image
                src={logoImage}
                alt="Penida-Go"
                width={140}
                height={36}
                class="h-7 w-auto object-contain"
                loading="lazy"
                format="webp"
              />
            </a>
            <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
              Layanan transportasi wisata dan transfer privat terpercaya di Bali & Nusa Penida. Aman, tepat waktu, dan harga transparan langsung lewat WhatsApp.
            </p>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-400 pt-1">
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400"></span> Sanur Harbor, Bali</span>
              <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-400"></span> Toya Pakeh, Nusa Penida</span>
            </div>
          </div>

          <!-- Navigation links -->
          <div>
            <h4 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Navigasi</h4>
            <nav aria-label="Footer navigation">
              <ul class="space-y-2.5 text-sm text-slate-400">
                <li><a href="#routes"       class="hover:text-ocean-400 transition-colors">Popular Routes</a></li>
                <li><a href="#services"     class="hover:text-ocean-400 transition-colors">Our Services</a></li>
                <li><a href="#pricing"      class="hover:text-ocean-400 transition-colors">Transparent Pricing</a></li>
                <li><a href="#testimonials" class="hover:text-ocean-400 transition-colors">Customer Reviews</a></li>
                <li><a href="#faq"          class="hover:text-ocean-400 transition-colors">FAQ</a></li>
              </ul>
            </nav>
          </div>

          <!-- Contact & Socials -->
          <div>
            <h4 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Hubungi Kami</h4>
            <p class="text-sm text-slate-400 mb-2">WhatsApp Reservasi 24/7:</p>
            <a href={SITE_INFO.whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-block text-emerald-400 hover:text-emerald-300 font-medium text-sm mb-5">
              +62 812-3456-7890
            </a>
            <div class="flex items-center gap-3">
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Penida-Go di Instagram" class="w-9 h-9 rounded-full bg-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:bg-ocean-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
              </a>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Penida-Go di Facebook" class="w-9 h-9 rounded-full bg-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:bg-ocean-700 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.667 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"/></svg>
              </a>
              <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="Penida-Go di TikTok" class="w-9 h-9 rounded-full bg-slate-800 flex items-center justify-center text-slate-300 hover:text-white hover:bg-ocean-700 transition-colors">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
          <p>© {new Date().getFullYear()} Penida-Go. All rights reserved.</p>
          <div class="flex items-center gap-6">
            <a href="/terms"   class="hover:text-slate-400">Terms of Service</a>
            <a href="/privacy" class="hover:text-slate-400">Privacy Policy</a>
            <a href="/refund"  class="hover:text-slate-400">Refund Policy</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu JS (zero-overhead inline) -->
    <script is:inline>
      (function () {
        const btn      = document.getElementById('mobile-menu-btn');
        const menu     = document.getElementById('mobile-menu');
        const iMenu    = document.getElementById('icon-menu');
        const iClose   = document.getElementById('icon-close');

        function close() {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          iMenu.classList.remove('hidden');
          iClose.classList.add('hidden');
        }

        if (btn && menu) {
          btn.addEventListener('click', () => {
            const open = !menu.classList.contains('hidden');
            open ? close() : (
              menu.classList.remove('hidden'),
              btn.setAttribute('aria-expanded', 'true'),
              iMenu.classList.add('hidden'),
              iClose.classList.remove('hidden')
            );
          });
          menu.querySelectorAll('.mobile-nav-link').forEach(l => l.addEventListener('click', close));
        }
      })();
    </script>
  </body>
</html>
